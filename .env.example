# === Cérebro (LLM com visão) ===
# Qual provedor usar: "anthropic" (Claude) ou "openai"
LLM_PROVIDER=anthropic

# --- Se usar Claude (anthropic) ---
# RECOMENDADO: NÃO precisa de chave! Rode `ant auth login` uma vez
# (opção "Seu próprio computador" no Console) e deixe ANTHROPIC_API_KEY vazio.
# Só preencha se preferir usar uma chave explícita.
ANTHROPIC_API_KEY=

# --- Se usar OpenAI ---
OPENAI_API_KEY=

# Modelo com visão. Exemplos:
#   anthropic:  claude-opus-5-5     (melhor qualidade, mais caro)
#               claude-sonnet-5-5   (ótimo equilíbrio — recomendado p/ uso frequente)
#               claude-haiku-5-5    (mais barato, p/ leituras simples)
#   openai:     gpt-4o   (ou gpt-4o-mini para mais barato)
LLM_MODEL=claude-sonnet-5-5

# === Riot API (opcional, usado nas fases seguintes p/ histórico/rank) ===
RIOT_API_KEY=
RIOT_REGION=americas

# === Idioma das respostas ===
COACH_LANG=pt-BR
