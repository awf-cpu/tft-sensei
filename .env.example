# === Cérebro (LLM com visão) ===
# Qual provedor usar: "openai" ou "anthropic"
LLM_PROVIDER=openai

# Coloque a chave do provedor escolhido (deixe só a que for usar)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Modelo com visão. Exemplos:
#   openai:     gpt-4o   (ou gpt-4o-mini para mais barato)
#   anthropic:  claude-sonnet-4-5
LLM_MODEL=gpt-4o

# === Riot API (opcional, usado nas fases seguintes p/ histórico/rank) ===
RIOT_API_KEY=
RIOT_REGION=americas

# === Idioma das respostas ===
COACH_LANG=pt-BR
